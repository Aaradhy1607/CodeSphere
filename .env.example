# ========================================================
# CODESPHERE - PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ========================================================

APP_ENV=production
ENVIRONMENT=production
SECRET_KEY=replace-with-a-strong-random-32-character-secret-key
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Initial Super Admin Bootstrap (Required in Production)
INITIAL_ADMIN_EMAIL=admin@institution.edu
INITIAL_ADMIN_PASSWORD=replace-with-secure-initial-admin-password
INITIAL_ADMIN_NAME="Primary Administrator"

# Code Execution Sandboxing (Docker Required in Production)
CODESPHERE_EXECUTION_BACKEND=docker
REQUIRE_DOCKER_SANDBOX=true
ALLOW_LOCAL_PROCESS_FALLBACK=false

# Background Worker & Code Runner Concurrency
CODE_RUNNER_MAX_CONCURRENCY=8
CODE_RUNNER_TIMEOUT_SECONDS=5.0
WORKER_CONCURRENCY=4

# Redis Distributed Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true

# Institutional Email Domains
STUDENT_EMAIL_DOMAIN=std.ggsipu.ac.in
ADMIN_EMAIL_DOMAIN=ipu.ac.in
