# ==========================================
# CODESPHERE - USAR PRODUCTION ENVIRONMENT
# ==========================================

ENVIRONMENT=development

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://codesphere_admin:codesphere_secure_password_2026@localhost:5432/codesphere_production
# Fallback local sqlite: DATABASE_URL=sqlite:///./codesphere.db

# Database Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True

# Redis & Distributed Caching
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=True
CACHE_DEFAULT_TTL=60
CACHE_PREFIX=codesphere:

# Distributed Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_WINDOW=60

# Code Execution Sandbox Concurrency Limiter
CODE_RUNNER_MAX_CONCURRENCY=8
CODE_RUNNER_TIMEOUT_SECONDS=5.0

# Background Worker Concurrency
WORKER_CONCURRENCY=4

# JWT Authentication
SECRET_KEY=codesphere-usar-super-secret-jwt-key-2026-production-ready
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# Initial Admin Bootstrap
INITIAL_ADMIN_EMAIL=placement@ipu.ac.in
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_NAME="Dr. A. K. Sharma (Placement Head)"

# Institutional Email Domains
STUDENT_EMAIL_DOMAIN=std.ggsipu.ac.in
ADMIN_EMAIL_DOMAIN=ipu.ac.in

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External APIs
GEMINI_API_KEY=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
