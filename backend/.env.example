# ==========================================
# CODESPHERE - USAR CONFIGURATION TEMPLATE
# ==========================================

# Environment: "development" or "production"
ENVIRONMENT=development

# Database Configuration (PostgreSQL in production; SQLite allowed in development)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
# For local development: DATABASE_URL=sqlite:///./codesphere.db

# Database Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True

# Redis & Distributed Caching
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=True
CACHE_DEFAULT_TTL=60
CACHE_PREFIX=codesphere:

# Distributed Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_WINDOW=60

# Code Execution Sandbox Concurrency & Backend
CODESPHERE_EXECUTION_BACKEND=local
REQUIRE_DOCKER_SANDBOX=False
ALLOW_LOCAL_PROCESS_FALLBACK=True
CODE_RUNNER_MAX_CONCURRENCY=8
CODE_RUNNER_TIMEOUT_SECONDS=5.0

# Background Worker Concurrency
WORKER_CONCURRENCY=4

# JWT Authentication (MUST be at least 32 characters in production)
SECRET_KEY=replace-with-a-strong-random-32-char-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# Initial Admin Bootstrap (Set strong initial credentials)
INITIAL_ADMIN_EMAIL=admin@ipu.ac.in
INITIAL_ADMIN_PASSWORD=replace-with-secure-initial-admin-password
INITIAL_ADMIN_NAME="System Super Administrator"

# CORS Configuration (Comma-separated allowed origins; Wildcard '*' is forbidden in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Institutional Email Domains
STUDENT_EMAIL_DOMAIN=std.ggsipu.ac.in
ADMIN_EMAIL_DOMAIN=ipu.ac.in

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External APIs (Optional)
GEMINI_API_KEY=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
